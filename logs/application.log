2025-04-06 17:14:27 INFO  s.u.e.m.file.util.TextFileExport - 	 32 Msg: MessageAnalysisVO{disentangledId=465, text='`%^(?:(?:https?|ftp)://)(?:\\S+(?::\\S)?@|\\d{1,3}(?:\\.\\d{1,3}){3}|(?:(?:[az\\d\\x{00a1}\\x{ffff}]+?)[az\\d\\x{00a1}\\x{ffff}]+)(?:\\.(?:[az\\d\\x{00a1}\\x{ffff}]+?)[az\\d\\x{00a1}\\x{ffff}]+)(?:\\.[az\\x{00a1}\\x{ffff}]{2,6}))(?::\\d+)?(?:[^\\s])?$%iu`it's beautiful', sender='Heidy', sentTime=Fri Apr 10 09:42:53 CDT 2020}
