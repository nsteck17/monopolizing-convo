2025-04-06 17:14:27 INFO  s.u.e.m.file.util.TextFileExport - 	 22 Msg: MessageAnalysisVO{disentangledId=671, text='```pythonfrom modules import configfrom azure.common.credentials import ServicePrincipalCredentialsfrom azure.mgmt.resource import ResourceManagementClientfrom azure.mgmt.sql import SqlManagementClientdef is_active():  Custom logic to enable/disable this adapter  return Truedef get():  Creates connection and gets service level of SQL DB with Azure SDK: https://pypi.org/project/azuremgmt/  # Pull credentials from keychain. principal = str(config.usernames["azprincipal"]) principal_secret = str(config.passwords["azprincipal"]) subscription_id = str(config.settings["adapters_output_azmgr_dtu_azsubid"]) tenant_id = str(config.settings["adapters_output_azmgr_dtu_aztenant"]) # Create our credentials for use with the resource client and sql client. credentials = ServicePrincipalCredentials(client_id=principal secret=principal_secret tenant=tenant_id) # Create Resource Client resource_client = ResourceManagementClient(credentials subscription_id) # Create SQL Client sql_client = SqlManagementClient(credentials subscription_id) # Azure SQL DB Server Information Variables servername = str(config.settings["adapters_output_azmgr_dtu_servername"]) groupname = str(config.settings["adapters_output_azmgr_dtu_groupname"]) dbname = str(config.settings["adapters_output_azmgr_dtu_dbname"]) # Retrieve current service level & objective for our database. service_level = sql_client.service_tier_advisors.get(server_name=servername resource_group_name=groupname database_name=dbname service_tier_advisor_name=\'Current\') service_objectives = sql_client.service_objectives.get(server_name=servername resource_group_name=groupname database_name=dbname service_objective_name=\'\') print(service_objectives) print(service_level) help(sql_client.servicebus.ServiceBusService) return```', sender='Izabelle', sentTime=Thu Jan 16 17:27:53 CST 2020}
