<message conversation_id="7">
  <ts>2020-04-01T02:31:43.589000</ts>
  <user>Lucius</user>
  <text>```pykwargs = { a': A', foo': bar'}foo(kwargs)# equivalent tofoo(a='A foo='bar')```</text>
