  <text>Ok I am more comfortable with threading</text>
</message>
<message conversation_id="88">
  <ts>2020-04-02T18:48:15.093000</ts>
  <user>Blayne</user>
  <text>Threading is easier but asyncio is the better solution</text>
</message>
<message conversation_id="88">
  <ts>2020-04-02T18:48:16.872000</ts>
  <user>Blayne</user>
  <text>Up2u</text>
</message>
<message conversation_id="88">
  <ts>2020-04-02T18:48:22.983000</ts>
