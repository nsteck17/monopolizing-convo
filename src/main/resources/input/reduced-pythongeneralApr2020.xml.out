</message>
<message conversation_id="88">
  <ts>2020-04-02T18:48:42.022000</ts>
  <user>Elies</user>
  <text>Why would async be better</text>
</message>
<message conversation_id="88">
  <ts>2020-04-02T18:48:55.457000</ts>
  <user>Blayne</user>
  <text>Better performance and better code</text>
</message>
<message conversation_id="88">
  <ts>2020-04-02T18:49:02.366000</ts>
